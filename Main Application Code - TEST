// Navigation routes
sealed class Screen(val route: String, val title: String, val icon: ImageVector) {
    object Dashboard : Screen("dashboard", "Dashboard", Icons.Default.Home)
    object AddTransaction : Screen("add_transaction", "Add Transaction", Icons.Default.Add)
    object BudgetOverview : Screen("budget_overview", "Budget Overview", Icons.Default.AccountBalance)
    object BillsManagement : Screen("bills_management", "Bills Management", Icons.Default.Receipt)
    object AddBill : Screen("add_bill", "Add Bill", Icons.Default.AddCard)
}

// Keep the original Transaction data class
data class Transaction(
    val id: String = UUID.randomUUID().toString(),
    val label: String,
    val amount: Double,
    val isIncome: Boolean,
    val timestamp: Long = System.currentTimeMillis()
)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        
        // Initialize database and repository
        val database = BudgetDatabase.getDatabase(applicationContext)
        val repository = TransactionRepository(database.transactionDao())
        val viewModelFactory = BudgetViewModelFactory(repository)
        
        setContent {
            BudgetAppTheme {
                PersonalFinanceApp(viewModelFactory = viewModelFactory)
            }
        }
    }
}

@Composable
fun BudgetAppTheme(content: @Composable () -> Unit) {
    MaterialTheme(
        colorScheme = lightColorScheme(
            primary = Color(0xFF1976D2),
            secondary = Color(0xFF03DAC6),
            tertiary = Color(0xFFFF5722),
            surface = Color(0xFFF5F5F5),
            background = Color(0xFFFFFFFF),
            onSurface = Color(0xFF212121)
        ),
        content = content
    )
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun PersonalFinanceApp(viewModelFactory: BudgetViewModelFactory) {
    val navController = rememberNavController()
    val viewModel: BudgetViewModel = viewModel(factory = viewModelFactory)
    
    Scaffold(
        topBar = {
            TopAppBar(
                title = { 
                    Text(
                        "Personal Finance App",
                        fontWeight = FontWeight.Bold
                    ) 
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = MaterialTheme.colorScheme.primary,
                    titleContentColor = Color.White
                )
            )
        }
    ) { paddingValues ->
        NavHost(
            navController = navController,
            startDestination = Screen.Dashboard.route,
            modifier = Modifier.padding(paddingValues)
        ) {
            composable(Screen.Dashboard.route) {
                DashboardScreen(
                    navController = navController,
                    viewModel = viewModel
                )
            }
            composable(Screen.AddTransaction.route) {
                AddTransactionScreen(
                    navController = navController,
                    viewModel = viewModel
                )
            }
            composable(Screen.BudgetOverview.route) {
                BudgetOverviewScreen(
                    navController = navController,
                    viewModel = viewModel
                )
            }
            composable(Screen.BillsManagement.route) {
                BillsManagementScreen(
                    navController = navController,
                    viewModel = viewModel
                )
            }
            composable(Screen.AddBill.route) {
                AddBillScreen(
                    navController = navController,
                    viewModel = viewModel
                )
            }
        }
    }
}

@Composable
fun DashboardScreen(
    navController: NavController,
    viewModel: BudgetViewModel
) {
    val transactions by viewModel.transactions.collectAsState()
    val totalIncome by viewModel.totalIncome.collectAsState()
    val totalExpenses by viewModel.totalExpenses.collectAsState()
    val balance by viewModel.balance.collectAsState()
    
    val currencyFormat = NumberFormat.getCurrencyInstance()
    
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(MaterialTheme.colorScheme.background)
            .padding(16.dp)
    ) {
        // Quick Stats Card
        Card(
            modifier = Modifier
                .fillMaxWidth()
                .padding(bottom = 24.dp),
            elevation = CardDefaults.cardElevation(defaultElevation = 6.dp),
            colors = CardDefaults.cardColors(
                containerColor = MaterialTheme.colorScheme.surface
            )
        ) {
            Column(
                modifier = Modifier.padding(20.dp)
            ) {
                Text(
                    text = "Current Balance",
                    fontSize = 16.sp,
                    color = Color.Gray,
                    modifier = Modifier.padding(bottom = 8.dp)
                )
                Text(
                    text = currencyFormat.format(balance),
                    fontSize = 28.sp,
                    fontWeight = FontWeight.Bold,
                    color = if (balance >= 0) Color(0xFF2E7D32) else Color(0xFFD32F2F)
                )
                
                Spacer(modifier = Modifier.height(12.dp))
                
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Column {
                        Text("Income", fontSize = 14.sp, color = Color.Gray)
                        Text(
                            currencyFormat.format(totalIncome),
                            fontSize = 16.sp,
                            fontWeight = FontWeight.SemiBold,
                            color = Color(0xFF2E7D32)
                        )
                    }
                    Column {
                        Text("Expenses", fontSize = 14.sp, color = Color.Gray)
                        Text(
                            currencyFormat.format(totalExpenses),
                            fontSize = 16.sp,
                            fontWeight = FontWeight.SemiBold,
                            color = Color(0xFFD32F2F)
                        )
                    }
                }
            }
        }
        
        // Navigation Menu
        Text(
            text = "Quick Actions",
            fontSize = 20.sp,
            fontWeight = FontWeight.Bold,
            modifier = Modifier.padding(bottom = 16.dp)
        )
        
        // Navigation Cards
        val navigationItems = listOf(
            Screen.AddTransaction,
            Screen.BudgetOverview,
            Screen.BillsManagement
        )
        
        navigationItems.forEach { screen ->
            NavigationCard(
                title = screen.title,
                icon = screen.icon,
                onClick = { navController.navigate(screen.route) }
            )
        }
        
        // Recent Transactions
        if (transactions.isNotEmpty()) {
            Spacer(modifier = Modifier.height(24.dp))
            Text(
                text = "Recent Transactions",
                fontSize = 20.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(bottom = 12.dp)
            )
            
            LazyColumn {
                items(transactions.take(3)) { transaction ->
                    TransactionItem(transaction = transaction)
                }
            }
        }
    }
}

@Composable
